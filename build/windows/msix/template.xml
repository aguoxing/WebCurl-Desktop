<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX Packaging Tool 模板：`task windows:create:msix:package USE_MSIX_TOOL=true` 使用。
     PublisherName / PublisherDisplayName 必须与用于签名的证书主题一致，
     换成自签名证书时要同步改这两行（另一份 app_manifest.xml 同理）。 -->
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="webcurl-desktop.exe"
        Arguments=""
        InstallLocation="C:\Program Files\aguoxing\WebCurl">
    </Installer>
    <PackageInformation
        PackageName="WebCurl"
        PackageDisplayName="WebCurl"
        PublisherName="CN=aguoxing"
        PublisherDisplayName="aguoxing"
        Version="1.0.1.0"
        PackageDescription="WebCurl Desktop - an API debugging and mock workbench">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.aguoxing.webcurl"
                Description="WebCurl Desktop - an API debugging and mock workbench"
                DisplayName="WebCurl"
                ExecutableName="webcurl-desktop.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>WebCurl</DisplayName>
            <PublisherDisplayName>aguoxing</PublisherDisplayName>
            <Description>WebCurl Desktop - an API debugging and mock workbench</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="webcurl-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
